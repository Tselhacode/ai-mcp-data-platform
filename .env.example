# Copy this file to .env and fill in values.
# Never commit .env to git.

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/db.sqlite

# LLM Provider
# Options: fake, bedrock
LLM_PROVIDER=fake
LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
LLM_MAX_TOKENS=4096
LLM_MAX_ITERATIONS=10

# AWS (only required if LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
# AWS credentials are read from the standard boto3 credential chain:
# - Environment variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# - ~/.aws/credentials
# - IAM role (EC2/ECS)
# Do NOT set AWS_ACCESS_KEY_ID here in production — use IAM roles.

# MCP
# Options: stdio, sse
MCP_TRANSPORT=stdio

# API
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# LangSmith (optional — tracing and evaluation datasets)
# Leave LANGSMITH_TRACING=false (or unset) for local dev without LangSmith.
# Never set LANGSMITH_TRACING=true in test environments.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=ai-mcp-data-platform
